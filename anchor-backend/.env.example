APP_ENV=dev
APP_NAME=ProjectAnchor
SECRET_KEY=change_me

POSTGRES_DSN=postgresql+psycopg://anchor:anchorpass@postgres:5432/anchor
REDIS_URL=redis://redis:6379/0

MAX_DRAWDOWN_PCT=0.20
LOSS_STREAK_N=3
COOLDOWN_HOURS=48

MANUAL_24H_X=3
MANUAL_DAYS_Y=2

# Read-only MCP credential for ANCHOR_CONTROL_MCP_V1.
# Leave unset to keep POST /mcp fail-closed. Never commit a real token.
# ANCHOR_CONTROL_MCP_TOKEN=
# Deploy-time: list the real Anchor service and timer units. The default
# post-production monitoring unit alone is not the full runtime picture.
# ANCHOR_CONTROL_MCP_SERVICE_UNITS=
# ANCHOR_CONTROL_MCP_TIMER_UNITS=
# Host sidecar only (127.0.0.1:8001). Do not set these inside the Docker backend.
# Recommended: SERVICE_UNITS=docker.service and an empty TIMER_UNITS.
# See anchor-backend/docs/ANCHOR_CONTROL_MCP_HOST_SIDECAR_V1.md.
# ANCHOR_CONTROL_MCP_HOST_SIDECAR=1
# ANCHOR_CONTROL_MCP_BIND=127.0.0.1:8001
# ANCHOR_CONTROL_MCP_BACKEND_PROBE=1
