[Unit]
Description=Run the Official V2 ledger read-only mirror every 10 minutes
Documentation=file:/path/to/project-anchor/anchor-backend/docs/ANCHOR_LEDGER_READONLY_MIRROR_V1.md
After=anchor-official-ledger.service

[Timer]
OnBootSec=2min
OnCalendar=*:0/10
AccuracySec=30s
Persistent=true
Unit=anchor-ledger-readonly-mirror.service

[Install]
WantedBy=timers.target
